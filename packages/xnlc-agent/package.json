      "require": "./lib-cjs/tools.js"
    },
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "import": "./lib/runtime.js",
      "require": "./lib-cjs/runtime.js"
    },
    "./project-cards": {
      "types": "./lib/project-cards.d.ts",
      "import": "./lib/project-cards.js",
      "require": "./lib-cjs/project-cards.js"
    },
    "./project-details": {
      "types": "./lib/project-details.d.ts",
      "import": "./lib/project-details.js",
      "require": "./lib-cjs/project-details.js"
