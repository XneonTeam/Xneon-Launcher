# Cloud OAuth client_id — скопируй в .env и заполни своими значениями
# Не коммить .env в репозиторий!
# Полный список читается scripts/gen-credentials.mjs
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
YANDEX_CLIENT_ID=
ONEDRIVE_CLIENT_ID=
ELY_CLIENT_ID=
ELY_CLIENT_SECRET=
ELY_DEVICE_CLIENT_ID=
# XN Skins: необязательно (legacy). Client ID берётся из electrobun/main/auth.ts,
# поэтому пустые значения дают предупреждение, а не ошибку сборки.
XN_CLIENT_ID=
XN_CLIENT_SECRET=
# OAuth — стандартный вход Minecraft; Device Code — собственное приложение Xneon.
# Это два независимых Client ID. Client Secret desktop-приложению не нужен.
MICROSOFT_CLIENT_ID=00000000402b5328
MICROSOFT_DEVICE_CLIENT_ID=
# Необязательно: ключ AnySearch API для инструмента агента web_search.
# Без ключа поиск работает анонимно с меньшими лимитами; web_fetch работает всегда.
ANYSEARCH_API_KEY=
# XNLC/Share: по умолчанию https://share.xneon.org. Адрес задаётся только этим
# ключом; `bun run dev:share` сам подставляет http://127.0.0.1:8787.
# XNLC_SHARE_URL=https://share.xneon.org
# Необязательно: тот же ключ CurseForge, что входит в сборку, но для каталога модов
# и установки модпаков из Share. CF_API_KEY имеет приоритет, CURSEFORGE_API_KEY —
# совместимое имя. Оба значения только переопределяют встроенный ключ.
# CF_API_KEY=

# ── Окружение запущенного приложения (main) ───────────────────────────────────
# Эти значения не встраиваются в бандл, а читаются из окружения процесса при
# запуске; в релизной сборке их задают в системе, а не в этом файле.
# XNLC_NEWS_URL=https://launcher.xneon.org/news.json
# XNLC_LIVEOPS_URL=https://liveops.xneon.org
# XN_VERBOSE_LOGS=true
# XNLC_SCAN_WORKER=1
