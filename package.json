{
  "name": "xneon-launcher",
  "version": "1.0.6",
  "description": "Xneon Launcher desktop application",
  "author": {
    "name": "Xneon Launcher",
    "email": "support@xneon.org"
  },
  "homepage": "https://launcher.xneon.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XneonTeam/Xneon-Launcher.git"
  },
  "private": true,
  "main": "dist-electron/main/index.js",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/prismjs": "^1.26.6",
    "@xnlc/core": "workspace:*",
    "@xnlc/mods": "workspace:*",
    "@xnlc/nbt": "workspace:*",
    "@xnlc/servers": "workspace:*",
    "@xnlc/skins": "workspace:*",
    "@xnlc/types": "workspace:*",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "better-sqlite3": "^13.0.3",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "form-data": "^4.0.6",
    "i18next": "^26.3.6",
    "iconv-lite": "^0.7.3",
    "prismjs": "^1.30.0",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.4.2",
    "three": "^0.185.1",
    "toml": "^5.0.0",
    "webdav": "^5.10.0"
  },
  "scripts": {
    "sync:xnlc": "node scripts/sync-local-xnlc.mjs",
    "predev": "node scripts/gen-credentials.mjs",
    "prebuild": "node scripts/gen-credentials.mjs",
    "prepackage": "node scripts/gen-credentials.mjs",
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json && wait-on tcp:127.0.0.1:5173 --timeout 60000 && cross-env NODE_ENV=development node scripts/launch-electron-dev.mjs\"",
    "dev:fast": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 --timeout 15000 && cross-env NODE_ENV=development node scripts/launch-electron-dev.mjs\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build && pnpm run build:electron",
    "package": "pnpm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-skins.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "1.3.8",
    "@radix-ui/react-dialog": "1.1.20",
    "@radix-ui/react-select": "2.3.4",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10",
    "@types/better-sqlite3": "^7.6.13"
  },
  "build": {
    "appId": "com.xneonlauncher.app",
    "productName": "Xneon Launcher",
    "npmRebuild": false,
    "forceCodeSigning": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "XneonTeam",
      "repo": "Xneon-Launcher"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "${name}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/node_modules/@xnlc/*/src/**",
      "!**/node_modules/@xnlc/*/scripts/**",
      "!**/node_modules/@xnlc/*/tsconfig.json",
      "!**/node_modules/@xnlc/*/*.ts",
      "!**/node_modules/@xnlc/*/.npmrc"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.xz",
        "pacman"
      ],
      "category": "Game",
      "maintainer": "Xneon Launcher <support@xneon.org>",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libsecret-1-0",
        "libappindicator3-1",
        "libxss1"
      ]
    },
    "rpm": {
      "depends": [
        "libnotify",
        "libsecret",
        "libappindicator-gtk3",
        "libXScrnSaver"
      ]
    },
    "appImage": {
      "artifactName": "${name}-${version}-x86_64.${ext}"
    },
    "pacman": {
      "artifactName": "${name}-${version}-x86_64.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "${name}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
