{
  "name": "xneon-launcher",
  "version": "1.0.3",
  "description": "XNeon Launcher desktop application",
  "author": {
    "name": "XNeon Launcher",
    "email": "support@xneon.org"
  },
  "homepage": "launcher.xneon.org",
  "private": true,
  "main": "dist-electron/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.7.0",
    "discord-rpc": "^4.0.1",
    "form-data": "^4.0.0",
    "iconv-lite": "^0.7.2",
    "prismarine-nbt": "^2.8.0",
    "sql.js": "^1.14.1"
  },
  "scripts": {
    "sync:xnlc": "node scripts/sync-local-xnlc.mjs",
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"npm run sync:xnlc && tsc -p tsconfig.node.json && wait-on http://127.0.0.1:5173 --timeout 15000 && cross-env NODE_ENV=development node scripts/launch-electron-dev.mjs\"",
    "dev:diag": "concurrently -k -s first \"vite --host 127.0.0.1\" \"npm run sync:xnlc && tsc -p tsconfig.node.json && wait-on http://127.0.0.1:5173 --timeout 15000 && cross-env NODE_ENV=development ELECTRON_DEBUG_FLAGS=1 node scripts/launch-electron-dev.mjs\"",
    "dev:diag:no-shm": "concurrently -k -s first \"vite --host 127.0.0.1\" \"npm run sync:xnlc && tsc -p tsconfig.node.json && wait-on http://127.0.0.1:5173 --timeout 15000 && cross-env NODE_ENV=development ELECTRON_DEBUG_FLAGS=1 ELECTRON_DISABLE_DEV_SHM_USAGE=0 node scripts/launch-electron-dev.mjs\"",
    "dev:diag:no-sandbox": "concurrently -k -s first \"vite --host 127.0.0.1\" \"npm run sync:xnlc && tsc -p tsconfig.node.json && wait-on http://127.0.0.1:5173 --timeout 15000 && cross-env NODE_ENV=development ELECTRON_DEBUG_FLAGS=1 ELECTRON_NO_SANDBOX=0 node scripts/launch-electron-dev.mjs\"",
    "build:renderer": "vite build",
    "build:electron": "npm run sync:xnlc && tsc -p tsconfig.node.json",
    "build": "vite build && npm run build:electron",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test:xn-auth": "node scripts/test-xn-auth.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "depcheck": "^1.4.7",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.2",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.xneonlauncher.app",
    "productName": "XNeon Launcher",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/xnlc/src/**",
      "!**/xnlc/test*",
      "!**/xnlc/installer.log",
      "!**/xnlc/tsconfig.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "maintainer": "XNeon Launcher <support@xneon.org>"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
